rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the submissionToken matches the target team document
    function isValidTeamToken(teamId, token) {
      return exists(/databases/$(database)/documents/teams/$(teamId))
        && get(/databases/$(database)/documents/teams/$(teamId)).data.submissionToken == token;
    }

    match /teams/{teamId} {
      // Reads are open (needed for the public captain link to look up a team by token,
      // and for the coach app's team list). Only creation is open — there is no coach
      // auth in this app yet, so update/delete must stay closed or any visitor could
      // rewrite or delete a team's submissionToken and hijack/destroy its captain link.
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /matchReports/{reportId} {
      // Public captain submission: only allowed if payload contains a valid teamId and matching submissionToken
      allow create: if request.resource.data.teamId != null
                    && request.resource.data.submissionToken != null
                    && isValidTeamToken(request.resource.data.teamId, request.resource.data.submissionToken);
      
      // Coach app reads & management
      allow read, update, delete: if true;
    }
  }
}
