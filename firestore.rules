rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getCoachData() {
      return get(/databases/$(database)/documents/coaches/$(request.auth.uid)).data;
    }

    function isHeadCoach() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/coaches/$(request.auth.uid))
        && getCoachData().role == 'head_coach';
    }

    function isAssistantOrHeadCoach() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }

    function stationInvitation(tokenHash) {
      return get(/databases/$(database)/documents/stationInvitations/$(tokenHash)).data;
    }

    // An observation submitted from /station/:token. The leader proves they hold a live
    // invitation, and the note is confined to what a station leader may say: a training
    // note, on that invitation's session, visible to all coaches. It can never be
    // confidential, and it cannot be edited or removed without an account.
    function isStationLeaderNote() {
      return request.resource.data.stationTokenHash is string
        && exists(/databases/$(database)/documents/stationInvitations/$(request.resource.data.stationTokenHash))
        && stationInvitation(request.resource.data.stationTokenHash).get('revokedAt', null) == null
        && stationInvitation(request.resource.data.stationTokenHash).sessionId == request.resource.data.sessionId
        && request.resource.data.source == 'training'
        && request.resource.data.access.staffVisibility == 'all_coaches'
        && !('visibility' in request.resource.data);
    }

    function isValidTeamToken(teamId, token) {
      return exists(/databases/$(database)/documents/clubTeams/$(teamId))
        && get(/databases/$(database)/documents/clubTeams/$(teamId)).data.submissionToken == token;
    }

    // 1. Captain Public Collections (No login required)
    // clubTeams must be publicly readable so an unauthenticated captain can look
    // up their team by submissionToken (used by both /report/:token and the
    // matchReports create check below); writes remain coach-only.
    match /clubTeams/{teamId} {
      allow read: if true;
      allow write: if isAssistantOrHeadCoach();
    }

    match /matchReports/{reportId} {
      // Captains submit without an account, proving themselves with their team token.
      allow create: if request.resource.data.teamId != null
                    && request.resource.data.submissionToken != null
                    && isValidTeamToken(request.resource.data.teamId, request.resource.data.submissionToken);
      // Reading a report means reading a captain's assessment of their players, and only
      // coaches do that. Nothing in the app edits or removes a submitted report.
      allow read, update, delete: if isAssistantOrHeadCoach();
    }

    // 2. Coach Accounts & Invites
    match /coaches/{uid} {
      allow read: if isAssistantOrHeadCoach();

      // Only created via a valid, unconsumed invite matching the requested role.
      // The first head coach account is created manually in the Firebase Console.
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.inviteId is string
                    && get(/databases/$(database)/documents/coachInvites/$(request.resource.data.inviteId)).data.used == false
                    && get(/databases/$(database)/documents/coachInvites/$(request.resource.data.inviteId)).data.role == request.resource.data.role;

      allow update, delete: if isHeadCoach();
    }

    match /coachInvites/{inviteId} {
      allow get: if true;                 // needed so /invite/:token can look up its own invite
      allow list: if isHeadCoach();       // collection cannot be browsed/enumerated
      allow create: if isHeadCoach();
      allow update: if request.auth != null
                    && resource.data.used == false
                    && request.resource.data.used == true
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedByEmail', 'usedByUid']);
      allow delete: if isHeadCoach();
    }

    // 3. Shared Squad Data
    match /coachTeam/{teamId} { allow read, write: if isAssistantOrHeadCoach(); }
    match /facility/{facilityId} { allow read, write: if isAssistantOrHeadCoach(); }
    match /players/{playerId} {
      allow get: if true;
      allow list, write: if isAssistantOrHeadCoach();
    }
    match /activities/{activityId} { allow read, write: if isAssistantOrHeadCoach(); }
    match /matches/{matchId} { allow read, write: if isAssistantOrHeadCoach(); }
    match /trainingResources/{resourceId} { allow read, write: if isAssistantOrHeadCoach(); }
    match /clubTrainingSessions/{sessionId} {
      allow get: if true;
      allow list, create, delete: if isAssistantOrHeadCoach();
      allow update: if isAssistantOrHeadCoach()
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvps']);
    }
    match /rsvpInvitations/{tokenHash} {
      allow get: if true;
      allow list, create, update, delete: if isAssistantOrHeadCoach();
    }
    // Opaque, non-enumerable station invitations contain only a station-scoped
    // projection. Captains may fetch the one document named by their token hash.
    match /stationInvitations/{tokenHash} {
      allow get: if true;
      allow list, create, update, delete: if isAssistantOrHeadCoach();
    }
    match /fairnessLedger/{playerId} { allow read, write: if isAssistantOrHeadCoach(); }
    match /savedClubTemplates/{templateId} { allow read, write: if isAssistantOrHeadCoach(); }
    match /savedFieldSettings/{settingId} { allow read, write: if isAssistantOrHeadCoach(); }

    // 4. Role-Restricted Visibility Notes
    match /developmentFocuses/{focusId} {
      allow read: if isAssistantOrHeadCoach() && (
        resource.data.visibility != 'head_coach_only' || isHeadCoach()
      );
      allow create: if isAssistantOrHeadCoach() && (
        request.resource.data.visibility != 'head_coach_only' || isHeadCoach()
      );
      allow update, delete: if isAssistantOrHeadCoach() && (
        resource.data.visibility != 'head_coach_only' || isHeadCoach()
      );
    }

    match /observations/{observationId} {
      allow read: if isAssistantOrHeadCoach() && (
        resource.data.visibility != 'head_coach_only' || isHeadCoach()
      );
      // A station leader running a net has no account, so their note is authorised by
      // the station token instead: it must name a live invitation, match that
      // invitation's session, and stay inside the shape a station note can have.
      allow create: if isStationLeaderNote() || (isAssistantOrHeadCoach() && (
        request.resource.data.visibility != 'head_coach_only' || isHeadCoach()
      ));
      allow update, delete: if isAssistantOrHeadCoach() && (
        resource.data.visibility != 'head_coach_only' || isHeadCoach()
      );
    }
  }
}
